# Home Privacy Cleanup environment settings.
# Copy to .env.local for local work. Never commit real secrets.

# ---- Launch mode -------------------------------------------------------
# preview  : full sales experience with test data and test payments (default)
# interest : collects real inquiries; paid ordering is clearly not open yet
# sales    : paid ordering after eligibility approval. Only takes effect when
#            every requirement in docs/LAUNCH_CHECKLIST.md is met; otherwise
#            the site runs in interest mode.
LAUNCH_MODE=preview

# Public address of the site, no trailing slash. Must be https for sales mode.
SITE_URL=http://localhost:3000
# Allow search engines. Only honored in a production build, outside preview mode, on https.
SITE_INDEXABLE=false

# ---- Storage -----------------------------------------------------------
# Production on Vercel: a hosted Turso database (SQLite-compatible).
#   DATABASE_URL=libsql://<db-name>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token from the Turso dashboard>
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Local development: leave DATABASE_URL blank to use a local SQLite file.
DATABASE_PATH=./data/hpc.sqlite
# Only for a self-hosted server whose DATABASE_PATH is on a persistent disk.
DATABASE_DURABLE=false

# ---- Operator access ---------------------------------------------------
# Person responsible for reviewing requests (recorded on approvals).
OPERATOR_NAME=
# Admin password, 12+ characters. Admin is disabled until this and SESSION_SECRET are set.
ADMIN_PASSWORD=
# Random secret, 32+ characters. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ---- Public contact identity (do not invent) ---------------------------
CONTACT_EMAIL=
BUSINESS_LEGAL_NAME=
CONTACT_PHONE=
BUSINESS_MAILING_ADDRESS=
# Named on the privacy page, e.g. the company that hosts the site and database.
HOSTING_PROVIDER_NAME=

# ---- Payments (Stripe) -------------------------------------------------
# Preview: leave blank to use the on-site simulated test payment, or use an
# sk_test_ key plus a webhook secret to rehearse with Stripe test mode.
# Sales in production requires an sk_live_ key.
STRIPE_SECRET_KEY=
# Signing secret for the endpoint https://<your-site>/api/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded,
#  checkout.session.async_payment_failed, checkout.session.expired)
STRIPE_WEBHOOK_SECRET=

# ---- Transactional email (Resend) --------------------------------------
# In preview mode email is never sent; it is held in the admin outbox.
RESEND_API_KEY=
# A verified sender, e.g. "Home Privacy Cleanup <hello@your-domain>"
EMAIL_FROM=
EMAIL_REPLY_TO=
